{
  "name": "dsh-theme-linen",
  "version": "1.1.1",
  "description": "Warm neutral theme for the DeepSeek Harness Web GUI: warmer surfaces, rounder corners, sharper default fonts, configured from a settings page.",
  "type": "module",
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "theme", "warm", "neutral"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chuyuxuan0v0/deepseek-harness-theme-linen.git"
  },
  "homepage": "https://github.com/Chuyuxuan0v0/deepseek-harness-theme-linen#readme",
  "bugs": { "url": "https://github.com/Chuyuxuan0v0/deepseek-harness-theme-linen/issues" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "vendor/schemastery.mjs",
    "vendor/schemastery-LICENSE",
    "vendor/cosmokit.js",
    "vendor/cosmokit-LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-theme"]
    }
  }
}
